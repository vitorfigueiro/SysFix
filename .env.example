# ==============================================================================
# SysFix SaaS 2.0 - Arquivo de Exemplo de Configuração
# Copie este arquivo para ".env" dentro da pasta SysFix e preencha suas chaves.
# ==============================================================================

# Modo do backend:
# - auto: usa Firebase automaticamente quando as credenciais estiverem preenchidas; caso contrário usa modo local JSON
# - firebase: força uso do Firebase Auth + Cloud Firestore
# - local: força armazenamento local em JSON (ideal para testes e modo demo offline)
SYSFIX_BACKEND=auto

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Backend) - Escolha UMA das opções abaixo:
# ------------------------------------------------------------------------------
# Opção 1: Caminho para o arquivo JSON da Conta de Serviço baixado no Console do Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=

# Opção 2: Conteúdo JSON em uma única linha (útil para Render, Cloud Run, Railway, Docker)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# Firebase Web SDK (Frontend - Configurações do App Web no Firebase Console)
# ------------------------------------------------------------------------------
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# ------------------------------------------------------------------------------
# Segurança e Sessão (Modo Local / Assinatura interna)
# ------------------------------------------------------------------------------
# Se deixar vazio no modo local, o sistema gera uma chave segura em <SYSFIX_DATA_DIR>/.secret_key
SYSFIX_SECRET_KEY=
SYSFIX_TOKEN_TTL_HOURS=24

# Lista separada por vírgulas caso publique frontend e API em domínios separados (opcional)
SYSFIX_CORS_ORIGINS=

# ------------------------------------------------------------------------------
# Servidor e Armazenamento Local
# ------------------------------------------------------------------------------
SYSFIX_DATA_DIR=
HOST=127.0.0.1
PORT=8000
